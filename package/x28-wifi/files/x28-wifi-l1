#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# mt_wifi reads /etc/wireless/l1profile.dat once, when the module loads, and with the wrong one neither band comes up (MAC 00:..,
# no SSID). The original X28 has ONE combined MT7915D chip (one card); the X28 PRO has two MT7915 chips, one per band, on PCIe
# slots 0000 (5 GHz) and 0001 (2.4 GHz). An image carries whichever file its stock rootfs had (the general image: the original's,
# #513), so count the Wi-Fi chips on PCI and write the matching file. Both files are the stock ones of each board.
# Run before the module loads (S05, kmodloader is S10). Does nothing when the file already fits.
L1=${L1:-/etc/wireless/l1profile.dat}
PCI=${PCI:-/sys/bus/pci/devices}

chips=$(cat "$PCI"/*/class 2>/dev/null | grep -c '^0x0280\|^0x000280')  # network controller (this kernel prints the class as 0x000280); the PCIe root port is not
cards=$(grep -c '^INDEX[0-9]*=' "$L1" 2>/dev/null)
[ "$chips" = 1 ] || [ "$chips" = 2 ] || exit 0
[ "$chips" = "${cards:-0}" ] && exit 0

one() { cat <<'DAT'
Default
INDEX0=MT7915D
INDEX0_profile_path=/etc/wireless/mediatek/mt7915.dbdc.b0.dat;/etc/wireless/mediatek/mt7915.dbdc.b1.dat
INDEX0_init_script=/lib/wifi/mt7615e.lua;/lib/wifi/mt7615e.lua
INDEX0_init_compatible=mt7615e;mt7615e
INDEX0_EEPROM_offset=0x0
INDEX0_EEPROM_size=0x20000
INDEX0_EEPROM_name=e2p
INDEX0_main_ifname=ra0;rai0
INDEX0_ext_ifname=ra;rai
INDEX0_wds_ifname=wds;wdsi
INDEX0_apcli_ifname=apcli;apclii
INDEX0_mesh_ifname=mesh;meshi
INDEX0_nvram_zone=dev1;dev2
INDEX0_single_sku_path=/rom/etc/wireless/mediatek/mt7615e-sku.dat
INDEX0_bf_sku_path=/rom/etc/wireless/mediatek/mt7615e-sku-bf.dat
INDEX0_pcie_slot=0000
DAT
}

two() { cat <<'DAT'
Default
INDEX0=MT7915
INDEX0_profile_path=/etc/wireless/mediatek/mt7915.dbdc.b1.dat
INDEX0_init_script=/lib/wifi/mt7615e.lua
INDEX0_init_compatible=mt7615e
INDEX0_EEPROM_offset=0x0
INDEX0_EEPROM_size=0x20000
INDEX0_EEPROM_name=e2p-5g
INDEX0_main_ifname=rai0
INDEX0_ext_ifname=rai
INDEX0_wds_ifname=wdsi
INDEX0_apcli_ifname=apclii
INDEX0_mesh_ifname=meshi
INDEX0_nvram_zone=dev1
INDEX0_single_sku_path=/rom/etc/wireless/mediatek/mt7615e-sku.dat
INDEX0_bf_sku_path=/rom/etc/wireless/mediatek/mt7615e-sku-bf.dat
INDEX0_pcie_slot=0000
INDEX1=MT7915
INDEX1_profile_path=/etc/wireless/mediatek/mt7915.dbdc.b0.dat
INDEX1_init_script=/lib/wifi/mt7615e.lua
INDEX1_init_compatible=mt7615e
INDEX1_EEPROM_offset=0x0
INDEX1_EEPROM_size=0x20000
INDEX1_EEPROM_name=e2p-2g
INDEX1_main_ifname=ra0
INDEX1_ext_ifname=ra
INDEX1_wds_ifname=wds
INDEX1_apcli_ifname=apcli
INDEX1_mesh_ifname=mesh
INDEX1_nvram_zone=dev2
INDEX1_single_sku_path=/etc/wireless/mediatek/mt7615e-sku.dat
INDEX1_bf_sku_path=/etc/wireless/mediatek/mt7615e-sku-bf.dat
INDEX1_pcie_slot=0001
DAT
}

if [ "$chips" = 1 ]; then one; else two; fi > "$L1.new" && mv "$L1.new" "$L1" &&
	logger -t x28-wifi-l1 "$chips Wi-Fi chip(s): $chips-card l1profile.dat"
