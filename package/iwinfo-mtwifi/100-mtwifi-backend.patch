diff --git a/iwinfo_mtwifi.c b/iwinfo_mtwifi.c
new file mode 100644
index 0000000..e97a887
--- /dev/null
+++ b/iwinfo_mtwifi.c
@@ -0,0 +1,511 @@
+/*
+ * iwinfo - Wireless Information Library - MediaTek mt_wifi backend (ZLT X28, MT7915 DBDC)
+ *
+ * mt_wifi has no nl80211. Its wireless extensions answer ESSID, BSSID, channel, mode and bit rate, but report
+ * no frequency range, tx power list or stations. Those come from the country's channel tables and the driver's
+ * station table (RTPRIV_IOCTL_GET_MAC_TABLE_STRUCT), with the layout the stock firmware's ioctl_helper.so reads.
+ * ra0/ra1 are the 2.4 GHz band and rai0/rai1 the 5 GHz band; radio sections named *_2g / *_5g map to ra0 / rai0.
+ * The station table of an interface holds only that interface's clients (checked on the unit).
+ *
+ * Licensed under GPL-2.0 like the rest of iwinfo.
+ */
+
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "iwinfo.h"
+#include "iwinfo/utils.h"
+#include "api/wext.h"
+
+#define MTWIFI_SET		(SIOCIWFIRSTPRIV + 0x02)
+#define MTWIFI_GET_SURVEY	(SIOCIWFIRSTPRIV + 0x0D)
+#define MTWIFI_GET_MAC_TABLE	(SIOCIWFIRSTPRIV + 0x1F)
+#define MTWIFI_TABLE_SIZE	0x7938	/* buffer size the stock firmware passes */
+#define MTWIFI_ENTRY_SIZE	56
+
+/* Wi-Fi channel to MHz; 2.4 GHz (channel 14 is the odd one) or 5 GHz. */
+static int mtwifi_ch2mhz(int ch, int five)
+{
+	return five ? 5000 + ch * 5 : (ch == 14 ? 2484 : 2407 + ch * 5);
+}
+
+static const char *mtwifi_ifname(const char *name)
+{
+	size_t len = strlen(name);
+
+	if (!strcmp(name, "ra0") || !strcmp(name, "ra1") || !strcmp(name, "rai0") || !strcmp(name, "rai1"))
+		return name;
+	if (len > 3 && !strcmp(name + len - 3, "_2g"))
+		return "ra0";
+	if (len > 3 && !strcmp(name + len - 3, "_5g"))
+		return "rai0";
+	return NULL;
+}
+
+#define IFN(name) const char *ifn = mtwifi_ifname(name); if (!ifn) return -1
+
+static int mtwifi_probe(const char *name)
+{
+	struct iwreq wrq = {};
+	const char *ifn = mtwifi_ifname(name);
+
+	if (!ifn)
+		return 0;
+	strncpy(wrq.ifr_name, ifn, IFNAMSIZ - 1);
+	return iwinfo_ioctl(SIOCGIWNAME, &wrq) >= 0 && !strncmp(wrq.u.name, "RTWIFI", 6);
+}
+
+static int mtwifi_is_5g(const char *ifn)
+{
+	return !strncmp(ifn, "rai", 3);
+}
+
+static int mtwifi_mode(const char *n, int *b)    { IFN(n); return wext_ops.mode(ifn, b); }
+static int mtwifi_channel(const char *n, int *b) { IFN(n); return wext_ops.channel(ifn, b); }
+static int mtwifi_bitrate(const char *n, int *b) { IFN(n); return wext_ops.bitrate(ifn, b); }
+static int mtwifi_ssid(const char *n, char *b)   { IFN(n); return wext_ops.ssid(ifn, b); }
+static int mtwifi_bssid(const char *n, char *b)  { IFN(n); return wext_ops.bssid(ifn, b); }
+
+static int mtwifi_frequency(const char *n, int *b)
+{
+	int ch;
+
+	IFN(n);
+	if (wext_ops.channel(ifn, &ch) || ch <= 0)
+		return -1;
+	*b = mtwifi_ch2mhz(ch, mtwifi_is_5g(ifn));
+	return 0;
+}
+
+static int mtwifi_zero(const char *n, int *b)  { *b = 0; return 0; }
+static int mtwifi_none(const char *n, int *b)  { return -1; }
+static int mtwifi_nostr(const char *n, char *b) { return -1; }
+static int mtwifi_nolist(const char *n, char *b, int *l) { return -1; }
+
+static int mtwifi_hwmodelist(const char *n, int *b)
+{
+	IFN(n);
+	*b = mtwifi_is_5g(ifn) ? (IWINFO_80211_A | IWINFO_80211_N | IWINFO_80211_AC | IWINFO_80211_AX)
+	                       : (IWINFO_80211_B | IWINFO_80211_G | IWINFO_80211_N | IWINFO_80211_AX);
+	return 0;
+}
+
+static int mtwifi_htmodelist(const char *n, int *b)
+{
+	IFN(n);
+	*b = IWINFO_HTMODE_HT20 | IWINFO_HTMODE_HT40 | IWINFO_HTMODE_HE20 | IWINFO_HTMODE_HE40;
+	if (mtwifi_is_5g(ifn))
+		*b |= IWINFO_HTMODE_VHT20 | IWINFO_HTMODE_VHT40 | IWINFO_HTMODE_VHT80 | IWINFO_HTMODE_VHT160 |
+		      IWINFO_HTMODE_HE80 | IWINFO_HTMODE_HE160;
+	return 0;
+}
+
+static int mtwifi_hardware_name(const char *n, char *b)
+{
+	strcpy(b, "MediaTek MT7915 (mt_wifi)");
+	return 0;
+}
+
+static int mtwifi_phyname(const char *n, char *b)
+{
+	IFN(n);
+	strcpy(b, ifn);
+	return 0;
+}
+
+/* Value of a key in the 5 GHz profile; the handler renders both profiles with the same country. */
+static int mtwifi_profile(const char *key, char *val, size_t size)
+{
+	char line[128];
+	size_t klen = strlen(key);
+	int found = -1;
+	FILE *f = fopen("/etc/wireless/mediatek/mt7915.dbdc.b1.dat", "r");
+
+	if (!f)
+		return -1;
+	while (found && fgets(line, sizeof(line), f)) {
+		if (strncmp(line, key, klen) || line[klen] != '=')
+			continue;
+		snprintf(val, size, "%s", line + klen + 1);
+		val[strcspn(val, "\r\n")] = 0;
+		found = 0;
+	}
+	fclose(f);
+	return found;
+}
+
+static int mtwifi_country(const char *n, char *b)
+{
+	char val[8];
+
+	if (mtwifi_profile("CountryCode", val, sizeof(val)) || strlen(val) != 2)
+		return -1;
+	strcpy(b, val);
+	return 0;
+}
+
+/* The countries /usr/share/x28-wifi/regions maps to driver regions; rpcd names them from the ISO table. */
+static int mtwifi_countrylist(const char *n, char *buf, int *len)
+{
+	struct iwinfo_country_entry *e = (struct iwinfo_country_entry *)buf;
+	char line[16];
+	int cnt = 0;
+	FILE *f = fopen("/usr/share/x28-wifi/regions", "r");
+
+	if (!f)
+		return -1;
+	while (fgets(line, sizeof(line), f) && (cnt + 1) * (int)sizeof(*e) <= IWINFO_BUFSIZE) {
+		e->iso3166 = line[0] * 256 + line[1];
+		e->ccode[0] = line[0];
+		e->ccode[1] = line[1];
+		e->ccode[2] = 0;
+		e++;
+		cnt++;
+	}
+	fclose(f);
+	*len = cnt * sizeof(*e);
+	return 0;
+}
+
+/* ponytail: the channels of the region in the rendered profile, so a saved country shows after apply; no DFS flags,
+ * add them if LuCI should mark those channels. */
+static int mtwifi_freqlist(const char *n, char *buf, int *len)
+{
+	struct iwinfo_freqlist_entry *e = (struct iwinfo_freqlist_entry *)buf;
+	char val[8], line[128], *tok;
+	int i, cnt = 0, five;
+
+	IFN(n);
+	five = mtwifi_is_5g(ifn);
+	if (five) {
+		/* /usr/share/x28-wifi/channels5: "<CountryRegionABand> <channels...>", shared with the handler. */
+		int region = mtwifi_profile("CountryRegionABand", val, sizeof(val)) ? 9 : atoi(val);
+		FILE *f = fopen("/usr/share/x28-wifi/channels5", "r");
+
+		if (!f)
+			return -1;
+		while (fgets(line, sizeof(line), f))
+			if (atoi(line) == region)
+				break;
+		if (feof(f))
+			line[0] = 0;
+		fclose(f);
+		tok = strtok(line, " \n");
+		while (tok && (tok = strtok(NULL, " \n"))) {
+			memset(e, 0, sizeof(*e));
+			e->band = IWINFO_BAND_5;
+			e->channel = atoi(tok);
+			e->mhz = mtwifi_ch2mhz(e->channel, 1);
+			e++;
+			cnt++;
+		}
+	} else {
+		int last = !mtwifi_profile("CountryRegion", val, sizeof(val)) && atoi(val) == 1 ? 13 : 11;
+
+		for (i = 1; i <= last; i++, e++, cnt++) {
+			memset(e, 0, sizeof(*e));
+			e->band = IWINFO_BAND_24;
+			e->channel = i;
+			e->mhz = mtwifi_ch2mhz(i, 0);
+		}
+	}
+	*len = cnt * sizeof(*e);
+	return 0;
+}
+
+/* Rate word at +0x14: MCS bits 0-5 (VHT/HE: MCS 0-3, NSS-1 4-5), BW bits 7-8, short GI bit 9, mode bits 13-15. */
+static void mtwifi_rate(uint16_t w, struct iwinfo_rate_entry *r)
+{
+	unsigned mode = w >> 13, mcs = w & 0x3f;
+
+	r->mhz = 20 << ((w >> 7) & 3);
+	r->is_40mhz = r->mhz == 40;
+	r->is_short_gi = (w >> 9) & 1;
+	r->is_ht = mode == 2 || mode == 3;
+	r->is_vht = mode == 4;
+	r->is_he = mode >= 5;
+	if (r->is_vht || r->is_he) {
+		r->mcs = mcs & 0xf;
+		r->nss = ((mcs >> 4) & 3) + 1;
+	} else {
+		r->mcs = (r->is_ht) ? mcs : -1;
+	}
+}
+
+static int mtwifi_assoclist(const char *n, char *buf, int *len)
+{
+	struct iwinfo_assoclist_entry *out = (struct iwinfo_assoclist_entry *)buf;
+	struct iwreq wrq = {};
+	unsigned char *tab, *e;
+	uint64_t num;
+	int i, j, cnt = 0;
+
+	IFN(n);
+	tab = calloc(1, MTWIFI_TABLE_SIZE);
+	if (!tab)
+		return -1;
+	strncpy(wrq.ifr_name, ifn, IFNAMSIZ - 1);
+	wrq.u.data.pointer = tab;
+	wrq.u.data.length = MTWIFI_TABLE_SIZE;
+	if (iwinfo_ioctl(MTWIFI_GET_MAC_TABLE, &wrq) < 0) {
+		free(tab);
+		return -1;
+	}
+	memcpy(&num, tab, sizeof(num));
+	if (num > (MTWIFI_TABLE_SIZE - 8) / MTWIFI_ENTRY_SIZE)
+		num = 0;
+	for (i = 0; i < (int)num && (cnt + 1) * (int)sizeof(*out) <= IWINFO_BUFSIZE; i++) {
+		int8_t best = -127;
+		uint16_t rate;
+		uint32_t ct;
+
+		e = tab + 8 + i * MTWIFI_ENTRY_SIZE;
+		memset(out, 0, sizeof(*out));
+		memcpy(out->mac, e + 1, 6);
+		for (j = 0; j < 4; j++)
+			if ((int8_t)e[0xc + j] < 0 && (int8_t)e[0xc + j] > best)
+				best = (int8_t)e[0xc + j];
+		out->signal = out->signal_avg = best;
+		out->noise = -95;
+		memcpy(&ct, e + 0x10, sizeof(ct));
+		out->connected_time = ct;
+		memcpy(&rate, e + 0x14, sizeof(rate));
+		mtwifi_rate(rate, &out->tx_rate);
+		out->rx_rate = out->tx_rate;
+		out->is_authorized = out->is_authenticated = out->is_wme = 1;
+		out++;
+		cnt++;
+	}
+	free(tab);
+	*len = cnt * sizeof(*out);
+	return 0;
+}
+
+/* begin mtwifi_scan_line */
+/* One RTMPCommSiteSurveyData line: No Ch SSID(%-33s) BSSID Security(%-23s) Signal(%) W-Mode ExtCH NT SSID_Len. Columns
+ * are fixed up to the BSSID; the rest are tokens, as a Security of 23 chars or more runs into the signal digits. Returns
+ * 0 for other lines. */
+static int mtwifi_scan_line(const char *l, int five, struct iwinfo_scanlist_entry *e)
+{
+	char sec[40], wmode[16], ext[8], nt[4], *ciph;
+	unsigned m[6];
+	int i, ch, pct = -1, slen, used = 0;
+	size_t flen;
+
+	if (strlen(l) < 62 || sscanf(l + 4, "%d", &ch) != 1 || ch <= 0 ||
+	    sscanf(l + 41, "%2x:%2x:%2x:%2x:%2x:%2x", &m[0], &m[1], &m[2], &m[3], &m[4], &m[5]) != 6 ||
+	    sscanf(l + 61, "%39s%n", sec, &used) != 1)
+		return 0;
+	if (strlen(sec) >= 23 && (ciph = strrchr(sec, '/'))) {
+		while (*ciph && (*ciph < '0' || *ciph > '9'))
+			ciph++;
+		if (!strncmp(ciph - 2, "MP", 2))	/* CCMP256, GCMP128: those digits are the cipher's */
+			ciph += strlen(ciph) >= 3 ? 3 : 0;
+		if (*ciph)
+			pct = atoi(ciph);
+		*ciph = 0;
+	}
+	if (pct < 0) {
+		int more = 0;
+
+		if (sscanf(l + 61 + used, "%d%n", &pct, &more) != 1)
+			return 0;
+		used += more;
+	}
+	if (sscanf(l + 61 + used, "%15s %7s %3s %d", wmode, ext, nt, &slen) != 4)
+		return 0;
+
+	memset(e, 0, sizeof(*e));
+	for (i = 0; i < 6; i++)
+		e->mac[i] = m[i];
+	for (flen = 33; flen && l[8 + flen - 1] == ' '; flen--)
+		;
+	if (slen > 0 && (size_t)slen != flen && flen > 2 && !strncmp(l + 8, "0x", 2)) {
+		/* Not printable: the driver gives hex of the first 14 bytes at most. */
+		for (i = 0; i * 2 + 2 < (int)flen && i < IWINFO_ESSID_MAX_SIZE; i++) {
+			unsigned c;
+
+			if (sscanf(l + 10 + i * 2, "%2x", &c) != 1)
+				break;
+			e->ssid[i] = c;
+		}
+	} else if (slen > 0) {
+		memcpy(e->ssid, l + 8, flen < IWINFO_ESSID_MAX_SIZE ? flen : IWINFO_ESSID_MAX_SIZE);
+	}
+	e->mode = !strcmp(nt, "Ad") ? IWINFO_OPMODE_ADHOC : IWINFO_OPMODE_MASTER;
+	e->band = five ? IWINFO_BAND_5 : IWINFO_BAND_24;
+	e->channel = ch;
+	e->mhz = mtwifi_ch2mhz(ch, five);
+	/* The driver's percent back to dBm; 100 % is anything from -50 dBm up. */
+	e->signal = (pct >= 24 ? (pct - 24) * 10 / 26 - 80 : pct * 10 / 26 - 90) + 0x100;
+	e->quality = pct;
+	e->quality_max = 100;
+	e->ht_chan_info.primary_chan = ch;
+	e->ht_chan_info.secondary_chan_off = !strcmp(ext, "ABOVE") ? 1 : !strcmp(ext, "BELOW") ? 3 : 0;
+	e->ht_chan_info.chan_width = !!e->ht_chan_info.secondary_chan_off;
+
+	ciph = strchr(sec, '/');
+	if (ciph)
+		*ciph++ = 0;
+	if (!strcmp(sec, "OPEN") && (!ciph || !strcmp(ciph, "NONE")))
+		return 1;
+	e->crypto.enabled = 1;
+	if (!strcmp(sec, "OWE")) {
+		e->crypto.wpa_version = 4;
+		e->crypto.auth_suites = IWINFO_KMGMT_OWE;
+	} else if (strstr(sec, "WPA") || strstr(sec, "SAE")) {
+		int psk = !!strstr(sec, "PSK");
+
+		if (strstr(sec, "WPAPSK") || strstr(sec, "WPA1") || !strcmp(sec, "WPA"))
+			e->crypto.wpa_version |= 1;
+		if (strstr(sec, "WPA2"))
+			e->crypto.wpa_version |= 2;
+		if (strstr(sec, "WPA3") || strstr(sec, "SAE"))
+			e->crypto.wpa_version |= 4;
+		if (psk && (e->crypto.wpa_version & 3))
+			e->crypto.auth_suites |= IWINFO_KMGMT_PSK;
+		if ((psk || strstr(sec, "SAE")) && (e->crypto.wpa_version & 4))
+			e->crypto.auth_suites |= IWINFO_KMGMT_SAE;
+		if (!psk && !strstr(sec, "SAE"))
+			e->crypto.auth_suites |= IWINFO_KMGMT_8021x;
+	} else {
+		e->crypto.auth_algs = !strcmp(sec, "OPEN") ? IWINFO_AUTH_OPEN : !strcmp(sec, "SHARED") ? IWINFO_AUTH_SHARED :
+		                      IWINFO_AUTH_OPEN | IWINFO_AUTH_SHARED;
+	}
+	if (ciph && !strcmp(ciph, "WEP"))
+		e->crypto.pair_ciphers = IWINFO_CIPHER_WEP40 | IWINFO_CIPHER_WEP104;
+	else if (ciph && !strcmp(ciph, "TKIPAES"))
+		e->crypto.pair_ciphers = IWINFO_CIPHER_TKIP | IWINFO_CIPHER_CCMP;
+	else if (ciph && !strcmp(ciph, "TKIP"))
+		e->crypto.pair_ciphers = IWINFO_CIPHER_TKIP;
+	else if (ciph && !strcmp(ciph, "AES"))
+		e->crypto.pair_ciphers = IWINFO_CIPHER_CCMP;
+	else if (ciph && !strcmp(ciph, "GCMP256"))
+		e->crypto.pair_ciphers = IWINFO_CIPHER_GCMP256;
+	else if (ciph && !strcmp(ciph, "CCMP256"))
+		e->crypto.pair_ciphers = IWINFO_CIPHER_CCMP256;
+	else if (ciph && !strcmp(ciph, "GCMP128"))
+		e->crypto.pair_ciphers = IWINFO_CIPHER_GCMP;
+	e->crypto.group_ciphers = e->crypto.pair_ciphers;
+	return 1;
+}
+/* end mtwifi_scan_line */
+
+/* LuCI's Scan and Channel Analysis ask again every few seconds, and a survey takes the band off its channel, so start
+ * one at most this often and answer from the driver's table in between. */
+#define MTWIFI_SCAN_EVERY	30
+#define MTWIFI_SCAN_WAIT	4	/* about 4 s on either band (measured); slept here, as the table ioctl would wait in the kernel */
+#define MTWIFI_SCAN_BUF		5000			/* a table read returns at most about 4 KB, then continues at an index */
+
+static int mtwifi_scan_start(const char *ifn)
+{
+	char stamp[32], cmd[] = "SiteSurvey=";
+	struct iwreq wrq = {};
+	struct stat st;
+	FILE *f;
+
+	snprintf(stamp, sizeof(stamp), "/tmp/mtwifi-scan-%s", ifn);
+	if (!stat(stamp, &st) && time(NULL) - st.st_mtime < MTWIFI_SCAN_EVERY)
+		return 0;
+	/* An empty SSID makes it passive: nothing is sent on a channel the region might not allow. */
+	strncpy(wrq.ifr_name, ifn, IFNAMSIZ - 1);
+	wrq.u.data.pointer = cmd;
+	wrq.u.data.length = sizeof(cmd);
+	if (iwinfo_ioctl(MTWIFI_SET, &wrq) < 0)
+		return -1;
+	f = fopen(stamp, "w");
+	if (f)
+		fclose(f);
+	sleep(MTWIFI_SCAN_WAIT);
+	return 0;
+}
+
+static int mtwifi_scanlist(const char *n, char *buf, int *len)
+{
+	struct iwinfo_scanlist_entry *out = (struct iwinfo_scanlist_entry *)buf;
+	char *data, *line, *next;
+	const char *ifn = mtwifi_ifname(n);
+	int five, idx = 0, total = -1, cnt = 0;
+
+	if (!ifn)
+		return -1;
+	five = mtwifi_is_5g(ifn);
+	ifn = five ? "rai0" : "ra0";
+	if (mtwifi_scan_start(ifn))
+		return -1;
+	data = malloc(MTWIFI_SCAN_BUF + 1);
+	if (!data)
+		return -1;
+	while (total < 0 || idx < total) {
+		struct iwreq wrq = {};
+		int before = idx;
+
+		snprintf(data, MTWIFI_SCAN_BUF, "%d", idx);
+		strncpy(wrq.ifr_name, ifn, IFNAMSIZ - 1);
+		wrq.u.data.pointer = data;
+		wrq.u.data.length = MTWIFI_SCAN_BUF;
+		if (iwinfo_ioctl(MTWIFI_GET_SURVEY, &wrq) < 0 || wrq.u.data.length >= MTWIFI_SCAN_BUF)
+			break;
+		data[wrq.u.data.length] = 0;
+		for (line = data; line; line = next) {
+			next = strchr(line, '\n');
+			if (next)
+				*next++ = 0;
+			if (total < 0 && sscanf(line, "Total=%d", &total) == 1)
+				continue;
+			if ((cnt + 1) * (int)sizeof(*out) <= IWINFO_BUFSIZE && mtwifi_scan_line(line, five, out)) {
+				out++;
+				cnt++;
+				idx++;
+			}
+		}
+		if (idx == before)
+			break;
+	}
+	free(data);
+	*len = cnt * sizeof(*out);
+	return 0;
+}
