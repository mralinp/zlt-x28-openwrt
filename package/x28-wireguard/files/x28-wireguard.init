#!/bin/sh /etc/rc.common
# Loads the WireGuard module built for the vendor kernel. It has no symbol version check, so it waits until x28-bootok
# (S96) has reset slot A's boot tries, and a load that never finishes is not retried: a crash here must not become a
# boot loop or cost boot tries.

START=97

MOD=/lib/modules/4.19.205/wireguard.ko
MARK=/etc/x28-wireguard.loading

# Slot A's tries byte in the four misc copies, as in x28-bootok.
tries_reset() {
	local dev i
	grep -q 'bootslot=a' /proc/cmdline || return 1
	dev=/dev/$(sed -n 's/^\(mtd[0-9]*\): [0-9a-f]* [0-9a-f]* "misc"$/\1/p' /proc/mtd)
	for i in 0 1 2 3; do
		[ "$(dd if="$dev" bs=1 skip=$((2057 + 262144 * i)) count=1 2>/dev/null | hexdump -v -e '1/1 "%02x"')" = 00 ] || return 1
	done
}

start() {
	(
		[ -d /sys/module/wireguard ] && exit 0
		# The marker only protects against a loop if it survives the crash.
		grep -q ' /overlay ubifs ' /proc/mounts || { logger -t x28-wireguard "overlay is not persistent; not loading"; exit 0; }
		n=0
		until tries_reset; do
			n=$((n + 1))
			[ $n -gt 60 ] && { logger -t x28-wireguard "boot tries not reset after 5 min; not loading"; exit 0; }
			sleep 5
		done
		if [ -e "$MARK" ]; then
			logger -t x28-wireguard "previous load did not finish; not loading. Remove $MARK to try again"
			exit 0
		fi
		touch "$MARK"
		sync
		insmod "$MOD" || { logger -t x28-wireguard "insmod failed"; rm -f "$MARK"; exit 1; }
		for i in $(uci -q show network | sed -n "s/^network\.\([^.]*\)\.proto='wireguard'$/\1/p"); do
			ifup "$i"
		done
		sleep 120
		rm -f "$MARK"
		sync
	) </dev/null >/dev/null 2>&1 &
}
