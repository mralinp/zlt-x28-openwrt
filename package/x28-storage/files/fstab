config global
	option anon_swap '0'
	option anon_mount '0'
	option auto_swap '0'
	option auto_mount '0'
	option delay_root '0'
	option check_fs '0'

# The overlay on stock's "data" volume of user_data, attached by /lib/preinit/79_x28_user_data (#183).
config mount
	option target '/overlay'
	option device '/dev/ubi1_2'
	option enabled '1'
