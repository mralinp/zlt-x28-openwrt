# SPDX-License-Identifier: GPL-2.0-only
# Attach user_data so mount_root's `block extroot` can use stock's "data" volume as the overlay (#183, /etc/config/fstab):
# 278 MB against the 22.8 MB rootfs_data. Stock slot B keeps its files: nothing is formatted, the overlay's upper and
# work directories just sit next to them. Any failure here leaves the volume unused and rootfs_data serves as before.
# So does a unit that keeps failing to boot: from slot A's third try on, the hook leaves user_data alone, so a bad overlay
# or a fault in that partition can't run the tries up to stock B's repair, which erases A. x28-bootok resets the count.

# Tests point these at a fake /proc and /sys, and a directory instead of the mount point.
X28_UD_PROC=${X28_UD_PROC:-/proc}
X28_UD_SYS=${X28_UD_SYS:-/sys}
X28_UD_MNT=${X28_UD_MNT:-/tmp/x28-user-data}
X28_UD_DEV=${X28_UD_DEV:-/dev}

# preinit's /dev has only what hotplug made so far.
x28_ud_node() {
	[ -e "/dev/$1" ] || [ ! -r "$2/dev" ] || mknod "/dev/$1" c "$(cut -d: -f1 "$2/dev")" "$(cut -d: -f2 "$2/dev")"
}

# block keeps the image's root UUID in etc/.extroot-uuid on the volume and refuses a different one, which would drop a
# newly flashed image back to rootfs_data for good. So a new image starts this overlay fresh, as flashing does to rootfs_data.
x28_ud_new_image() {
	local root
	root="$(block info 2>/dev/null | sed -n 's|^/dev/ubiblock0_0: UUID="\([^"]*\)".*|\1|p')"
	[ -n "$root" ] || return 0
	mkdir -p "$X28_UD_MNT"
	mount -t ubifs /dev/ubi1_2 "$X28_UD_MNT" 2>/dev/null || return 0
	if [ -f "$X28_UD_MNT/etc/.extroot-uuid" ] && [ "$(cat "$X28_UD_MNT/etc/.extroot-uuid")" != "$root" ]; then
		# The tag goes last and only after the rest: a half-done wipe repeats next boot, old settings never meet a new image.
		rm -rf "$X28_UD_MNT/upper" "$X28_UD_MNT/work" && rm -f "$X28_UD_MNT/etc/.extroot-uuid" && x28_ud_keep
	elif [ ! -f "$X28_UD_MNT/etc/.extroot-uuid" ]; then
		x28_ud_keep
	fi
	rm -f "$X28_UD_MNT"/x28-keep-*.tgz "$X28_UD_MNT/x28-keep.new" || :
	umount "$X28_UD_MNT"
}

# Settings kept across an upgrade (#477): the old image's platform.sh left its backup here as x28-keep-<target slot>.tgz. A new image on
# that slot hands it to 80_mount_root as OpenWrt's own /sysupgrade.tgz (restored into the fresh overlay, passwd/shadow merged), with
# only the files below: settings and keys, nothing a boot script runs or sources (those never passed the build guard). An archive
# with a symlink, an absolute or ../ name, or that does not unpack is dropped and the image starts with its defaults.
X28_UD_KEEP="etc/config etc/passwd etc/group etc/shadow etc/dropbear etc/uhttpd.crt etc/uhttpd.key etc/luci-uploads etc/backup"
x28_ud_keep() {
	local slot keep tmp=/tmp/x28-keep p out
	slot="$(sed -n 's/.*bootslot=\([ab]\).*/\1/p' "$X28_UD_PROC/cmdline" 2>/dev/null)"
	keep="$X28_UD_MNT/x28-keep-$slot.tgz"
	[ -n "$slot" ] && [ -s "$keep" ] || return 0
	rm -rf "$tmp"
	if tar -tzf "$keep" 2>/dev/null | grep -q '^/\|\(^\|/\)\.\.\(/\|$\)' || ! mkdir -p "$tmp/x" "$tmp/y/etc" ||
	   ! tar -xzf "$keep" -C "$tmp/x" 2>/dev/null || [ -n "$(find "$tmp/x" -type l)" ]; then
		echo "- x28: kept settings unusable, starting with defaults -"; rm -rf "$tmp"; return 0
	fi
	for p in $X28_UD_KEEP; do [ ! -e "$tmp/x/$p" ] || mv "$tmp/x/$p" "$tmp/y/$p"; done
	# Written aside and renamed: 80_mount_root ignores tar's status, so a truncated archive would restore half an /etc.
	out="$X28_UD_MNT/upper/.x28-restore.tgz"
	if mkdir -p "$X28_UD_MNT/upper" && (cd "$tmp/y" && tar -czf "$out" etc) && mv "$out" "$X28_UD_MNT/upper/sysupgrade.tgz"; then
		echo "- x28: settings kept by the upgrade will be restored -"
	else
		rm -f "$out"
	fi
	rm -rf "$tmp"
}

# The running slot's tries in misc, this boot's included (record at 2048, tries at byte 9 for A, 13 for B, as in x28-bootok). Read only; empty if unreadable.
x28_ud_tries() {
	local misc off
	case "$(cat "$X28_UD_PROC/cmdline" 2>/dev/null)" in *bootslot=a*) off=2057 ;; *bootslot=b*) off=2061 ;; *) return 0 ;; esac
	misc="$(sed -n 's/^\(mtd[0-9]*\): .* "misc"$/\1/p' "$X28_UD_PROC/mtd")"
	[ -n "$misc" ] || return 0
	x28_ud_node "$misc" "$X28_UD_SYS/class/mtd/$misc"
	dd if="$X28_UD_DEV/$misc" bs=1 skip=$off count=1 2>/dev/null | hexdump -v -e '1/1 "%u"'
}

do_x28_user_data() {
	local mtd tries
	mtd="$(sed -n 's/^mtd\([0-9]*\): .* "user_data"$/\1/p' "$X28_UD_PROC/mtd")"
	[ -n "$mtd" ] || return 0
	tries="$(x28_ud_tries)"
	[ "${tries:-0}" -lt 3 ] || return 0
	x28_ud_node ubi_ctrl "$X28_UD_SYS/class/misc/ubi_ctrl"
	ubiattach /dev/ubi_ctrl -m "$mtd" -d 1 >/dev/null 2>&1 || return 0
	x28_ud_node ubi1_2 "$X28_UD_SYS/class/ubi/ubi1_2"
	x28_ud_new_image
}

[ -n "$X28_UD_TEST" ] || boot_hook_add preinit_main do_x28_user_data
