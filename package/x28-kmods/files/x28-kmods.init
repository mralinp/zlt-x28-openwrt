#!/bin/sh /etc/rc.common
# Loads the modules we build for the vendor kernel (WireGuard #227, TPROXY/socket for Passwall2 #198, and the kmod-* feed
# packages, #416). They have no symbol version check, so this waits until x28-bootok (S96) has reset slot A's boot tries, and
# a load that never finishes is retried at most MAXTRY times in a row: a crash here must not become a boot loop or cost
# boot tries.
#
# Which modules, in which order: first MODS below (the modules an image bakes without packages), then every file in
# /etc/x28-kmods.d, in file name order, one module per line. Each module package ships its own file there
# (NN-<package>, NN = 50 plus its depth among our packages, so a package comes after the ones it needs), so installing
# or removing a package adds or removes its modules from the load, and nothing here changes. `x28-kmods modules` prints the
# resolved list.

START=97
EXTRA_COMMANDS="modules"
EXTRA_HELP="	modules	Print the modules that would be loaded, in order"

# Outside /lib/modules/4.19.205 so the kernel's modprobe (kmodloader) can't load them on demand, e.g. for a TPROXY rule,
# before the tries are reset or past the marker.
DIR=/lib/modules/x28
LISTDIR=/etc/x28-kmods.d
# Each module's dependencies first. Missing files are skipped, so an image may carry any subset.
MODS='wireguard x28_udp_lookup nf_socket_ipv4 nf_socket_ipv6 nf_tproxy_ipv4 nf_tproxy_ipv6 xt_socket xt_TPROXY'
MARK=/etc/x28-kmods.loading
MAXTRY=3

# The running slot's tries byte (A 2057, B 2061) in the four misc copies, as in x28-bootok.
tries_reset() {
	local dev i off
	if grep -q 'bootslot=a' /proc/cmdline; then off=2057
	elif grep -q 'bootslot=b' /proc/cmdline; then off=2061
	else return 1; fi
	dev=/dev/$(sed -n 's/^\(mtd[0-9]*\): [0-9a-f]* [0-9a-f]* "misc"$/\1/p' /proc/mtd)
	for i in 0 1 2 3; do
		[ "$(dd if="$dev" bs=1 skip=$((off + 262144 * i)) count=1 2>/dev/null | hexdump -v -e '1/1 "%02x"')" = 00 ] || return 1
	done
}

# MODS, then the list files; a name that appears twice is loaded once.
module_list() {
	{
		for m in $MODS; do echo "$m"; done
		cat "$LISTDIR"/* 2>/dev/null
	} | sed 's/#.*//; s/[[:space:]]//g; /^$/d' | awk '!seen[$0]++'
}

modules() {
	module_list
}

start() {
	(
		todo=
		for m in $(module_list); do
			[ -e "$DIR/$m.ko" ] && [ ! -d "/sys/module/$(echo "$m" | tr - _)" ] && todo="$todo $m"
		done
		[ -n "$todo" ] || exit 0
		# The marker only protects against a loop if it survives the crash.
		grep -q ' /overlay ubifs ' /proc/mounts || { logger -t x28-kmods "overlay is not persistent; not loading"; exit 0; }
		n=0
		until tries_reset; do
			n=$((n + 1))
			[ $n -gt 60 ] && { logger -t x28-kmods "boot tries not reset after 5 min; not loading"; exit 0; }
			sleep 5
		done
		# The marker holds the number of loads that did not finish. A reboot inside the 120 s window (not a crash) leaves one
		# behind, so a single stale marker must not disable the modules for good: only MAXTRY in a row stop the loading.
		fails=$(cat "$MARK" 2>/dev/null); fails=${fails:-0}
		case $fails in *[!0-9]*) fails=$MAXTRY;; esac
		if [ "$fails" -ge "$MAXTRY" ]; then
			logger -t x28-kmods "$fails loads in a row did not finish; not loading. Remove $MARK to try again"
			exit 0
		fi
		[ "$fails" -gt 0 ] && logger -t x28-kmods "previous load did not finish ($fails of $MAXTRY); trying again"
		echo $((fails + 1)) > "$MARK"
		sync
		# Vendor modules that algif_*, xt_hashlimit, ip6table_raw and nfnetlink_log link against.
		for d in af_alg x_tables ip6_tables nfnetlink; do [ -d "/sys/module/$d" ] || insmod "/lib/modules/4.19.205/$d.ko" 2>/dev/null; done
		for m in $todo; do
			insmod "$DIR/$m.ko" || { logger -t x28-kmods "insmod $m failed"; rm -f "$MARK"; exit 1; }
		done
		for i in $(uci -q show network | sed -n "s/^network\.\([^.]*\)\.proto='wireguard'$/\1/p"); do
			ifup "$i"
		done
		# Passwall2's own boot start may have run before xt_TPROXY was in; its rules need it.
		[ -d /sys/module/xt_TPROXY ] && [ "$(uci -q get passwall2.@global[0].enabled)" = 1 ] && /etc/init.d/passwall2 restart
		sleep 120
		rm -f "$MARK"
		sync
	) </dev/null >/dev/null 2>&1 &
}
