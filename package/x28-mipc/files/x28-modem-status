#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Read-only modem state for the LuCI Carrier tab, one "key<TAB>value" per line:
#   operator, selection (auto|manual), registration (home|roaming|none), lock (off|<earfcn>:<pci>), apn,
#   serving and cell: "<earfcn>:<pci><TAB>band<TAB>rsrp dBm<TAB>rsrq dB" (the serving cell first, then neighbours).
#   rat: lte | lte_ca | endc (4G + 5G NSA) | nr | other, and nrsig: "<rsrp><TAB><rsrq>" of the 5G leg (negative dBm / dB), both from
#   x28-nrband signal; absent when the tool is old or the modem has no 5G measurement.
#   ca: carrier aggregation, "<carriers> carriers: <MHz>+<MHz>+... (<total> MHz)" from AT+ECAINFO; absent when not aggregating.
# Cells come from AT+ECELL (LTE only; quarter-dB units). Values are what the modem reports, nothing is written.

cells() {
	# +ECELL: <n>,<rat 7|13>,<serving: cellid,tac,mcc,mnc,pci,x,y,rsrp,rsrq,,,,,earfcn,rat,mask,mask,,>, then 15 fields per neighbour.
	# An ARFCN above the LTE range is an NR cell (5G NSA); its signal reads 255 when the modem has none.
	tr -d '\r' | sed -n 's/^+ECELL: *//p' | head -n 1 | awk -F, '
		function band(e) {
			if (e <= 599) return 1; if (e >= 1200 && e <= 1949) return 3; if (e >= 2750 && e <= 3449) return 7
			if (e >= 3450 && e <= 3799) return 8; if (e >= 6150 && e <= 6449) return 20; if (e >= 9210 && e <= 9659) return 28
			if (e >= 37750 && e <= 38249) return 38; if (e >= 38650 && e <= 39649) return 40; if (e >= 39650 && e <= 41589) return 41
			if (e >= 41590 && e <= 43589) return 42; if (e >= 43590 && e <= 45589) return 43; return "?"
		}
		function nrband(e) {
			if (e >= 620000 && e <= 653333) return "n78"; if (e > 653333 && e <= 680000) return "n77"
			if (e >= 514000 && e <= 524000) return "n38"; if (e >= 499200 && e <= 537999) return "n41"; if (e >= 460000 && e <= 480000) return "n40"
			if (e >= 422000 && e <= 434000) return "n1"; if (e >= 361000 && e <= 376000) return "n3"; if (e >= 173800 && e <= 178800) return "n5"
			if (e >= 185000 && e <= 192000) return "n8"; if (e >= 158200 && e <= 164200) return "n20"; if (e >= 151600 && e < 158200) return "n28"
			return "n?"
		}
		function emit(key, pci, rsrp, rsrq, earfcn,   nr, sig) {
			if (pci !~ /^[0-9]+$/ || earfcn !~ /^[0-9]+$/ || rsrp !~ /^-?[0-9]+$/ || rsrq !~ /^-?[0-9]+$/) return
			nr = earfcn + 0 > 46589
			if (nr) key = "nrcell"
			if (rsrp + 0 == 255) { sig = "?\t?" } else { sig = sprintf("%.1f\t%.1f", rsrp / 4, rsrq / 4) }
			printf "%s\t%s:%s\t%s\t%s\n", key, earfcn, pci, nr ? nrband(earfcn) : band(earfcn), sig
		}
		$2 == 7 || $2 == 13 {
			emit("serving", $7, $10, $11, $16)
			for (i = 22; i <= NF; i += 15) emit("cell", $i, $(i + 3), $(i + 4), $(i + 9))
		}'
}

nrsig() {
	awk -F'[= ]' '
		$1 == "rat" { r = "other"; if ($2 == "1000") r = "lte"; if ($2 == "2000") r = "lte_ca"; if ($2 == "4000") r = "endc"; if ($2 == "8000") r = "nr"; printf "rat\t%s\n", r }
		$1 == "nr" { printf "nrsig\t-%d\t-%d\n", $2, $3 }'
}

ca() {
	# +ECAINFO: <secondary carriers>,<bandwidth of each carrier, 100 kHz units; 0 = unused>,... (seen: 3,150,200,200,150,0)
	tr -d '\r' | sed -n 's/^+ECAINFO: *//p' | head -n 1 | awk -F, '$1 + 0 > 0 {
		for (i = 2; i <= NF; i++) if ($i + 0 > 0) { n++; bw = bw (n > 1 ? "+" : "") $i / 10; sum += $i / 10 }
		if (n > 1) printf "ca\t%d carriers: %s (%s MHz)\n", n, bw, sum }'
}

selftest() {
	got=$(cat <<'EOS' | cells | tr '\t\n' '|;'
+ECELL: 4,13,"0016AC80C","ACBC",432,11,496,59,20,-328,-40,5,20,,0,1500,13,"00FFFFFFF","FFFF",,,134,52,5,-356,-70,,20,,,1500,13,"00FFFFFFF","FFFF",,,134,79,63,255,255,11,59,255,,650000,11,"00FFFFFFF","FFFFFFF",,,105,31,3,-440,-74,,10,,,2850,7,"00FFFFFFF","FFFF",,,
EOS
)
	want='serving|1500:496|3|-82.0|-10.0;cell|1500:134|3|-89.0|-17.5;nrcell|650000:134|n78|?|?;cell|2850:105|7|-110.0|-18.5;'
	[ "$got" = "$want" ] || { echo "got $got"; return 1; }
	got=$(printf '+ECAINFO: 3,150,200,200,150,0\r\n' | ca)
	[ "$got" = "$(printf 'ca\t4 carriers: 15+20+20+15 (70 MHz)')" ] || { echo "ca got $got"; return 1; }
	[ -z "$(printf '+ECAINFO: 0,200,0,0,0,0\n' | ca)" ] || { echo "ca should be empty without aggregation"; return 1; }
	got=$(printf 'rat=4000\nnr=80 14\n' | nrsig | tr '\t\n' '|;')
	[ "$got" = 'rat|endc;nrsig|-80|-14;' ] || { echo "nrsig got $got"; return 1; }
	[ "$(printf 'rat=1000\n' | nrsig | tr '\t\n' '|;')" = 'rat|lte;' ] || { echo "nrsig lte"; return 1; }
	echo "selftest ok"
}

at() { mipc_wan_cli --at_cmd "$1" 2>/dev/null | tr -d '\r'; }

status() {
	cops="$(at 'at+cops?' | sed -n 's/^+COPS: *\([0-9]*\),[0-9]*,"\([0-9]*\)".*/\1 \2/p' | head -n 1)"
	printf 'operator\t%s\n' "${cops#* }"
	case "${cops%% *}" in 0) sel=auto ;; '') sel=unknown ;; *) sel=manual ;; esac
	printf 'selection\t%s\n' "$sel"
	reg="$(at 'at+cereg?' | sed -n 's/^+CEREG: *[0-9]*,\([0-9]*\).*/\1/p' | head -n 1)"
	case "$reg" in 1) r=home ;; 5) r=roaming ;; *) r=none ;; esac
	printf 'registration\t%s\n' "$r"
	lock="$(at 'at+emmchlck?' | sed -n 's/^+EMMCHLCK: *0.*/off/p; s/^+EMMCHLCK: *1,7,0,\([0-9]*\),\([0-9]*\).*/\1:\2/p' | head -n 1)"
	printf 'lock\t%s\n' "${lock:-unknown}"
	[ -x /usr/sbin/x28-nrband ] && printf 'nrband_tool\tpresent\n' || printf 'nrband_tool\tmissing\n'
	printf 'apn\t%s\n' "$(mipc_wan_cli --apn_ia_get 2>/dev/null | sed -n 's/^IA apn:\([^ ]*\) .*/\1/p' | head -n 1)"
	[ -x /usr/sbin/x28-nrband ] && /usr/sbin/x28-nrband signal 2>/dev/null | nrsig
	at 'at+ecainfo?' | ca
	at 'at+ecell' | cells
}

case "$1" in
	selftest) selftest ;;
	cells) cells ;;
	*) status ;;
esac
