#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# IPv4 passthrough the way the stock firmware does it (#581): the LAN host with the configured MAC gets the cellular address
# by DHCP, with a gateway next to it that the X28 holds as a /32 on br-lan (proxy_arp answers for the rest of the subnet).
# ccmni keeps no IPv4 address; everything leaving it, the X28's own traffic and other LAN clients included, is SNATed to
# the cellular address, which is the identity for the host. Unsolicited inbound traffic is forwarded to the host.
#   x28-passthrough up DEV CELL MAC [DNS1 [DNS2]]   called by the x28_mipc proto after the bearer is up
#   x28-passthrough down                            called by the x28_mipc proto on teardown
#   x28-passthrough                                 firewall include (reload '1'): reapplies the state after fw3 or br-lan rebuilt
#   x28-passthrough selftest
# Tests point X28_PT_RUN at a private directory.
PT_RUN="${X28_PT_RUN:-/var/run}"
PT_STATE="$PT_RUN/x28-passthrough"
PT_TAG=x28-passthrough
PT_LEASE=10m

pt_ipv4() {
	case "$1" in ''|.*|*.|*..*|*[!0-9.]*) return 1 ;; esac
	local IFS=. o
	set -- $1
	[ "$#" -eq 4 ] || return 1
	for o in "$@"; do
		case "$o" in 0|[1-9]|[1-9][0-9]|[1-9][0-9][0-9]) [ "$o" -le 255 ] || return 1 ;; *) return 1 ;; esac
	done
}

pt_int() { local IFS=.; set -- $1; echo $(( ($1 << 24) | ($2 << 16) | ($3 << 8) | $4 )); }
pt_dot() { echo "$(( ($1 >> 24) & 255 )).$(( ($1 >> 16) & 255 )).$(( ($1 >> 8) & 255 )).$(( $1 & 255 ))"; }

# "GW PREFIX MASK" for a cellular address. Stock hands out /29 with the address + 1 as gateway, which breaks at the /29 edges;
# here the prefix widens until the address is a usable host, and the gateway is the address - 1 when + 1 is the broadcast.
pt_calc() {
	local c p=29 size net gw
	c="$(pt_int "$1")"
	while [ "$p" -ge 8 ]; do
		size=$((1 << (32 - p)))
		net=$((c & ~(size - 1) & 0xffffffff))
		[ "$c" -ne "$net" ] && [ "$c" -ne $((net + size - 1)) ] && break
		p=$((p - 1))
	done
	[ "$p" -ge 8 ] || return 1
	gw=$((c + 1))
	[ "$gw" -ne $((net + size - 1)) ] || gw=$((c - 1))
	echo "$(pt_dot "$gw") $p $(pt_dot $(( (0xffffffff << (32 - p)) & 0xffffffff )))"
}

pt_ipt() {  # pt_ipt TABLE CHAIN RULE...: insert once, at the top
	local t="$1" c="$2"
	shift 2
	iptables -t "$t" -C "$c" "$@" -m comment --comment "$PT_TAG" 2>/dev/null ||
		iptables -t "$t" -I "$c" 1 "$@" -m comment --comment "$PT_TAG"
}

pt_ipt_del() {
	local t="$1" c="$2"
	shift 2
	while iptables -t "$t" -D "$c" "$@" -m comment --comment "$PT_TAG" 2>/dev/null; do :; done
}

pt_confdir() {
	local d
	for d in /tmp/dnsmasq.d /tmp/dnsmasq.*.d; do [ -d "$d" ] && { echo "$d"; return 0; }; done
	return 1
}

# Everything but DHCP, idempotent: reapplied whenever fw3 reloads (it does on every interface change).
pt_apply() {
	pt_ipt nat POSTROUTING -o "$dev" -j SNAT --to-source "$cell" &&
	pt_ipt filter FORWARD -i "$dev" -d "$cell" -j ACCEPT &&
	pt_ipt filter FORWARD -i br-lan -s "$cell" -m mac ! --mac-source "$mac" -j DROP &&
	ip -4 addr replace "$gw/32" dev br-lan &&
	ip -4 route replace "$cell/32" dev br-lan &&
	echo 1 > "${X28_PT_SYSCTL:-/proc/sys/net/ipv4/conf}/br-lan/proxy_arp"
}

pt_remove() {
	pt_ipt_del nat POSTROUTING -o "$dev" -j SNAT --to-source "$cell"
	pt_ipt_del filter FORWARD -i "$dev" -d "$cell" -j ACCEPT
	pt_ipt_del filter FORWARD -i br-lan -s "$cell" -m mac ! --mac-source "$mac" -j DROP
	ip -4 route del "$cell/32" dev br-lan 2>/dev/null
	ip -4 addr del "$gw/32" dev br-lan 2>/dev/null
	echo "$proxy" > "${X28_PT_SYSCTL:-/proc/sys/net/ipv4/conf}/br-lan/proxy_arp" 2>/dev/null
	return 0
}

pt_load() {
	[ -f "$PT_STATE" ] || return 1
	read -r dev cell gw prefix mac proxy < "$PT_STATE"
	case "$dev" in ccmni[0-9]|ccmni[0-9][0-9]) ;; *) return 1 ;; esac
	pt_ipv4 "$cell" && pt_ipv4 "$gw"
}

pt_dhcp() {  # pt_dhcp [CONTENT]: write (or with no content remove) the dnsmasq snippet; restart dnsmasq if it changed
	local dir file
	dir="$(pt_confdir)" || { [ -z "$1" ]; return; }
	file="$dir/$PT_TAG.conf"
	if [ -n "$1" ]; then
		[ "$(cat "$file" 2>/dev/null)" = "$1" ] && return 0
		printf '%s\n' "$1" > "$file" || return 1
	else
		[ -f "$file" ] || return 0
		rm -f "$file"
	fi
	${X28_PT_DNSMASQ:-/etc/init.d/dnsmasq} restart >/dev/null 2>&1
	return 0
}

pt_down() {
	pt_load || { rm -f "$PT_STATE"; pt_dhcp ""; return 0; }
	rm -f "$PT_STATE"
	pt_remove
	pt_dhcp ""
	logger -t x28-passthrough "stopped for $cell"
	return 0
}

pt_up() {
	local dns1="$4" dns2="$5" calc mask conf
	dev="$1"; cell="$2"; mac="$(echo "$3" | tr 'A-F' 'a-f')"
	case "$dev" in ccmni[0-9]|ccmni[0-9][0-9]) ;; *) return 1 ;; esac
	pt_ipv4 "$cell" || return 1
	echo "$mac" | grep -Eqx '([0-9a-f]{2}:){5}[0-9a-f]{2}' || return 1
	{ [ -z "$dns1" ] || pt_ipv4 "$dns1"; } && { [ -z "$dns2" ] || pt_ipv4 "$dns2"; } || return 1
	calc="$(pt_calc "$cell")" || return 1
	set -- $calc
	gw="$1"; prefix="$2"; mask="$3"
	# A previous bearer may have left its state (netifd skips teardown when it is killed); undo it first.
	if [ -f "$PT_STATE" ]; then
		# In a subshell: pt_down loads the old state into the same variables.
		[ "$(cut -d' ' -f1-5 "$PT_STATE")" = "$dev $cell $gw $prefix $mac" ] || (pt_down)
	fi
	if [ ! -f "$PT_STATE" ]; then
		# The cellular subnet must not overlap the LAN, or the LAN would lose those addresses.
		ip -4 route get "$cell" 2>/dev/null | grep -q ' dev br-lan ' && { logger -t x28-passthrough "$cell is on the LAN; not passing it through"; return 1; }
		ip -4 route get "$gw" 2>/dev/null | grep -q ' dev br-lan ' && { logger -t x28-passthrough "$gw is on the LAN; not passing $cell through"; return 1; }
		proxy="$(cat "${X28_PT_SYSCTL:-/proc/sys/net/ipv4/conf}/br-lan/proxy_arp" 2>/dev/null)"
		case "$proxy" in 0|1) ;; *) proxy=0 ;; esac
		echo "$dev $cell $gw $prefix $mac $proxy" > "$PT_STATE" || return 1
	fi
	pt_load || return 1
	pt_apply || { pt_down; return 1; }
	# dnsmasq hands out only addresses of a subnet on the interface; shared-network adds the cellular one to br-lan.
	# A static range serves only the dhcp-host entry, so no other client can get the address.
	conf="shared-network=br-lan,$cell
dhcp-range=set:$PT_TAG,$cell,static,$mask,$PT_LEASE
dhcp-host=$mac,set:$PT_TAG,$cell,$PT_LEASE
dhcp-option=tag:$PT_TAG,option:router,$gw"
	[ -z "$dns1" ] || conf="$conf
dhcp-option=tag:$PT_TAG,option:dns-server,$dns1${dns2:+,$dns2}"
	pt_dhcp "$conf" || { pt_down; return 1; }
	# The rules above go when fw3 restarts; this include puts them back.
	if [ "$(uci -q get firewall.x28_passthrough)" != include ]; then
		uci -q batch <<-EOF
			set firewall.x28_passthrough=include
			set firewall.x28_passthrough.type=script
			set firewall.x28_passthrough.path=/sbin/x28-passthrough
			set firewall.x28_passthrough.reload=1
			commit firewall
		EOF
	fi
	logger -t x28-passthrough "$cell/$prefix gateway $gw to $mac on br-lan"
}

pt_selftest() {
	local c want got
	for c in '100.127.201.42 100.127.201.43 29 255.255.255.248' '10.0.0.41 10.0.0.42 29 255.255.255.248' \
		'10.0.0.46 10.0.0.45 29 255.255.255.248' '10.0.0.40 10.0.0.41 28 255.255.255.240' \
		'10.0.0.47 10.0.0.48 27 255.255.255.224' '10.0.1.0 10.0.1.1 23 255.255.254.0' '10.0.1.255 10.0.2.0 22 255.255.252.0'; do
		set -- $c
		want="$2 $3 $4"; got="$(pt_calc "$1")"
		[ "$got" = "$want" ] || { echo "FAIL: $1 gave '$got', want '$want'"; return 1; }
	done
	pt_ipv4 1.2.3 && { echo "FAIL: a bad address passed"; return 1; }
	echo "x28-passthrough selftest ok"
}

pt_main() {
	local dev cell gw prefix mac proxy lock="${X28_PT_LOCK:-/var/lock/x28-passthrough.lock}"
	case "$1" in selftest) pt_selftest; return ;; esac
	exec 8>"$lock" && flock 8 || return 1
	case "$1" in
		up) shift; pt_up "$@" ;;
		down) pt_down ;;
		'') ! pt_load || pt_apply ;;
		*) echo 'Usage: x28-passthrough up DEV CELL MAC [DNS1 [DNS2]] | down | selftest' >&2; return 1 ;;
	esac
}

# fw3 may source includes in a shared shell: run in a subshell so nothing here can exit or change that shell.
(pt_main "$@")
