#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Auto-tune (#599): resets the Carrier settings of the x28_mipc interface (roaming on, automatic operator, network mode and
# bands, no cell lock), then tries "automatic", "4G only" and a 4G lock to each LTE band the modem sees, measures each one's
# download bandwidth (all speed-test servers at once, 8 s) and keeps the one with the most. Ping is not scored (a latency
# mode for gaming is a later option). The data connection drops at every step, for up to about 10 minutes in all. The
# previous settings are saved first: `--restore` puts
# them back. A configuration that does not come up within 2 minutes scores 0; if the winner does not come back, automatic
# is applied.
# `--start` runs in the background (for LuCI), `--state` prints idle|running|done|failed, `--last` prints the results so far,
# one "label<TAB>Mbit/s<TAB>network<TAB>serving RSRP" per configuration and "best<TAB>label" at the end,
# `--stop` stops a run and restores. Speed-test servers: `list autotune_url` on the interface overrides the defaults.

OUT=${X28_AUTOTUNE_FILE:-/tmp/x28-autotune}
STATE=$OUT.state
PID=$OUT.pid
BAK=$OUT.bak
URLS='https://speed.cloudflare.com/__down?bytes=25000000 http://speedtest.tele2.net/10MB.zip'
CARRIER='roaming plmn celllock netmode lteband_mode lteband_list nrband_mode nrband_list'

iface() { uci -q show network | sed -n "s/^network\.\([^.]*\)\.proto='x28_mipc'$/\1/p" | head -n 1; }

# Candidates from x28-modem-status lines: "label<TAB>netmode<TAB>lteband_mode<TAB>bands". Automatic first (it is also the
# fallback), 4G only, then one lock per LTE band that has a measured cell, strongest first, at most 5.
candidates() {
	printf 'automatic\tauto\tnone\t\n4G only\t4g\tnone\t\n'
	awk -F'\t' '($1 == "serving" || $1 == "cell") && $3 ~ /^[0-9]+$/ && $4 ~ /^-?[0-9.]+$/ {
		if (!($3 in best) || $4 + 0 > best[$3]) best[$3] = $4 + 0 }
		END { for (b in best) printf "%s\t%s\n", best[b], b }' | sort -t'	' -k1,1nr | head -n 5 |
		awk -F'\t' '{ printf "4G band %s\tauto\tallow\t%s\n", $2, $2 }'
}

# Label of the highest Mbit/s (the first on a tie: automatic is listed first); nothing when no configuration moved any data.
best() {
	awk -F'\t' '$1 != "best" && $2 + 0 > m { m = $2 + 0; l = $1 } END { if (l != "") print l }'
}

save() {
	local o v
	for o in $CARRIER; do
		case "$o" in
			*_list) for v in $(uci -q get "network.$IF.$o"); do echo "add_list network.$IF.$o=$v"; done ;;
			*) v="$(uci -q get "network.$IF.$o")" && echo "set network.$IF.$o=$v" ;;
		esac
	done
}

clear_carrier() { local o; for o in $CARRIER; do uci -q delete "network.$IF.$o"; done; }

# apply <netmode> <lteband_mode> <bands>: roaming stays on, nothing else locked.
apply() {
	local b
	clear_carrier
	uci set "network.$IF.roaming=1"; uci set "network.$IF.netmode=$1"
	uci set "network.$IF.lteband_mode=$2"; uci set "network.$IF.nrband_mode=none"
	for b in $3; do uci add_list "network.$IF.lteband_list=$b"; done
	uci commit network
	ifup "$IF"
}

wait_up() {
	local i=0
	sleep 5
	until [ "$(ifstatus "$IF" 2>/dev/null | jsonfilter -e '@.up')" = true ]; do
		[ "$i" -ge 115 ] && return 1
		sleep 1; i=$((i + 1))
	done
	sleep 5  # let the bearer and the routes settle before measuring
}

# Download bandwidth in Mbit/s: every server at once for up to 8 s, the streams' rates summed, so the link is the limit rather
# than one server (a slow or blocked one only adds 0).
measure() {
	local u
	for u in $URLS; do
		curl -s -o /dev/null -m 8 -w '%{speed_download}\n' "$u" 2>/dev/null &
	done | awk '{ s += $1 } END { printf "%.1f\n", s * 8 / 1000000 }'
}

net() {
	/sbin/x28-modem-status 2>/dev/null | awk -F'\t' '$1 == "rat" { r = $2 } $1 == "serving" && !s { s = $4 }
		END { printf "%s\t%s\n", r ? r : "-", s ? s : "-" }'
}

run() {
	local cands label mode lte bands res win line
	[ "$(cat /tmp/x28-plmn-scan.state 2>/dev/null)" = running ] && { echo 'a network search is running' >&2; return 1; }
	[ -s "$BAK" ] || save > "$BAK"
	: > "$OUT"
	apply auto none ''
	wait_up || true  # the cell list below needs registration only, not data
	cands="$(/sbin/x28-modem-status 2>/dev/null | candidates)"
	while IFS='	' read -r label mode lte bands; do
		[ -n "$label" ] || continue
		[ "$label" = automatic ] || apply "$mode" "$lte" "$bands"
		if wait_up; then res="$(measure)"; else res=0.0; fi
		printf '%s\t%s\t%s\n' "$label" "$res" "$(net)" >> "$OUT"
	done <<EOF
$cands
EOF
	win="$(best < "$OUT")"
	line="$(echo "$cands" | awk -F'\t' -v l="${win:-automatic}" '$1 == l')"
	IFS='	' read -r label mode lte bands <<EOF
$line
EOF
	apply "$mode" "$lte" "$bands"
	wait_up || { label=automatic; apply auto none ''; }
	printf 'best\t%s\n' "${win:+$label}" >> "$OUT"
	logger -t x28-autotune "kept $label (${win:-no configuration moved any data})"
}

restore() {
	[ -s "$BAK" ] || return 0
	clear_carrier
	uci -q batch < "$BAK"
	uci commit network
	ifup "$IF"
}

selftest() {
	got=$(printf 'rat\tlte_ca\nserving\t1500:496\t3\t-82.0\t-10.0\ncell\t1500:134\t3\t-89.0\t-17.5\ncell\t2850:105\t7\t-110.0\t-18.5\ncell\t300:1\t1\t-95.5\t-12\nnrcell\t650000:134\tn78\t?\t?\ncell\t9:9\t?\t?\t?\n' | candidates | tr '\t\n' '|;')
	want='automatic|auto|none|;4G only|4g|none|;4G band 3|auto|allow|3;4G band 1|auto|allow|1;4G band 7|auto|allow|7;'
	[ "$got" = "$want" ] || { echo "candidates got $got"; return 1; }
	got=$(printf 'automatic\t12.5\tlte\t-82\n4G only\t12.5\tlte\t-82\n4G band 3\t31.0\tlte_ca\t-90\n' | best)
	[ "$got" = '4G band 3' ] || { echo "best got $got"; return 1; }
	got=$(printf 'automatic\t12.5\tlte\t-82\n4G only\t12.5\tlte\t-82\n' | best)
	[ "$got" = automatic ] || { echo "best tie got $got"; return 1; }
	[ -z "$(printf 'automatic\t0.0\t-\t-\nbest\t\n' | best)" ] || { echo "best should be empty without data"; return 1; }
	got=$(curl() { printf '%s\n' 1250000; }; URLS='a b'; measure)
	[ "$got" = 20.0 ] || { echo "measure got $got"; return 1; }
	echo "selftest ok"
}

[ "$1" = selftest ] && { selftest; exit; }
IF=$(iface)
[ -n "$IF" ] || { echo 'no x28_mipc interface' >&2; exit 1; }
u="$(uci -q get "network.$IF.autotune_url")" && URLS=$u

case "$1" in
	--last) cat "$OUT" 2>/dev/null ;;
	--state) cat "$STATE" 2>/dev/null || echo idle ;;
	--start)
		[ "$(cat "$STATE" 2>/dev/null)" = running ] && exit 0
		echo running > "$STATE"
		rm -f "$BAK"
		( r=failed; "$0" run >/dev/null 2>&1 && r=done; [ "$(cat "$STATE")" = running ] && echo "$r" > "$STATE" ) >/dev/null 2>&1 &
		;;
	--stop)
		[ "$(cat "$STATE" 2>/dev/null)" = running ] || exit 0
		echo failed > "$STATE"
		kill "$(cat "$PID" 2>/dev/null)" 2>/dev/null
		restore ;;
	--restore) restore ;;
	run) echo $$ > "$PID"; run ;;
	*) echo "usage: $0 --start|--state|--last|--stop|--restore|selftest" >&2; exit 1 ;;
esac
