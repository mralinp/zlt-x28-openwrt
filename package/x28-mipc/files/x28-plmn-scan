#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Scans for networks (AT+COPS=?), prints "plmn<TAB>name<TAB>act<TAB>status" per network and keeps the last result in
# /tmp/x28-plmn-scan. A scan takes up to a few minutes and the modem is off its network meanwhile: it drops the data
# connection, which comes back by itself afterwards (netifd retries). `--start` scans in the background (for LuCI),
# `--state` prints idle|running|done|failed, `--last` prints the cached result.
# status: 1 available, 2 current, 3 forbidden (3GPP), 0 unknown. act: 0 GSM, 2 UMTS, 7 LTE, 12/13 NR.

OUT=${X28_PLMN_SCAN_FILE:-/tmp/x28-plmn-scan}
SOCK=${X28_AT_SOCK:-/dev/adb_atci_socket}
STATE=$OUT.state

parse() {
	# +COPS: (2,"long","short","43244","2715",7),(1,"long","short","43235","7ED8",7),,(0-3),(0-2)  (the quoted hex is the area code)
	tr -d '\r' | sed -n 's/^+COPS: *//p' | sed 's/),,.*//; s/^(//; s/)$//; s/),(/\n/g' | awk -F, '
		{ gsub(/"/, ""); if ($4 ~ /^[0-9]+$/) printf "%s\t%s\t%s\t%s\n", $4, $2, $NF, $1 }'
}

# `mipc_wan_cli --at_cmd` gives up after about 5 s and segfaults, and a scan takes 30 s or more, so its answer was always lost.
# The modem's AT socket waits as long as we ask: send the command, read until OK or ERROR (or $2 seconds).
at() {
	lua - "$SOCK" "$1" "$2" <<'LUA'
local nixio = require "nixio"
local s = nixio.socket("unix", "stream")
if not s:connect(arg[1]) then os.exit(1) end
s:send(arg[2] .. "\r")
local buf, t0 = "", os.time()
while os.time() - t0 < tonumber(arg[3]) do
	if (nixio.poll({{fd = s, events = nixio.poll_flags("in")}}, 1000) or 0) > 0 then
		local d = s:recv(4096)
		if not d or #d == 0 then break end
		buf = buf .. d
		if buf:find("\nOK") or buf:find("ERROR") then break end
	end
end
io.write(buf)
LUA
}

selftest() {
	got=$(printf 'AT response:\r\n+COPS: (2,"MCI","MCI","43244","2715",7),(1,"Irancell","IR-TCI","43235","7ED8",7),(3,"X","X","99999","0001",2),,(0-3),(0-2)\r\n\r\nOK\r\n' | parse | tr '\t\n' '|;')
	want='43244|MCI|7|2;43235|Irancell|7|1;99999|X|2|3;'
	[ "$got" = "$want" ] || { echo "got $got"; return 1; }
	echo "selftest ok"
}

case "$1" in
	selftest) selftest ;;
	--last) cat "$OUT" 2>/dev/null ;;
	--state) cat "$STATE" 2>/dev/null || echo idle ;;
	--start)
		[ "$(cat "$STATE" 2>/dev/null)" = running ] && exit 0
		echo running > "$STATE"
		( r=failed; "$0" >/dev/null 2>&1 && r=done; echo "$r" > "$STATE" ) >/dev/null 2>&1 &
		;;
	*)
		res="$(at 'AT+COPS=?' 300 2>/dev/null | parse)"
		[ -n "$res" ] || exit 1
		printf '%s\n' "$res" > "$OUT"
		printf '%s\n' "$res" ;;
esac
