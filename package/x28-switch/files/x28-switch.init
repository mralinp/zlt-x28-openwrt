#!/bin/sh /etc/rc.common
START=18

fail() { echo "x28-switch: $*" >&2; : > /tmp/x28-switch.failed; return 1; }
chk() { want="$1"; shift; got=$(swconfig dev switch0 "$@" 2>/dev/null) && [ "$(echo $got)" = "$want" ]; }

start() {
	rm -f /tmp/x28-switch.failed
	[ "$(swconfig list 2>/dev/null)" = "Found: switch0 - MT7531AE" ] || { fail "unexpected switch"; return 1; }
	swconfig dev switch0 load network || { fail "load failed"; return 1; }
	chk 1 get enable_vlan || fail "vlan not enabled"
	chk '1 5t' vlan 1 get ports || fail 'vlan 1 ports'
	chk 1 port 1 get pvid || fail 'port 1 pvid'
	chk '2 5t' vlan 2 get ports || fail 'vlan 2 ports'
	chk 2 port 2 get pvid || fail 'port 2 pvid'
	chk '4 5t' vlan 3 get ports || fail 'vlan 3 ports'
	chk 3 port 4 get pvid || fail 'port 4 pvid'
	chk '0 6t' vlan 4 get ports || fail 'vlan 4 ports'
	chk 4 port 0 get pvid || fail 'port 0 pvid'
	[ ! -e /tmp/x28-switch.failed ]
}
